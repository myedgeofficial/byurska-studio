rules_version = '2';
// Do vsega imajo dostop samo člani ekipe s potrjeno e-pošto:
// Teo, Urška, Nives in Andjela od začetka, ostali, ko jih kdo doda v Nastavitve › Ekipa (dokument clani/{e-pošta}).
service cloud.firestore {
  match /databases/{database}/documents {
    function email() {
      return request.auth.token.email.lower();
    }
    function clan() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (email() in ['teo.simonic7@gmail.com', 'urska.repusic@gmail.com', 'nives.ploj@gmail.com', 'andjela.collab@gmail.com']
            || exists(/databases/$(database)/documents/clani/$(email())));
    }
    // Vse skupno vidijo vsi člani, razen osebnih map (zasebno/{e-pošta}/...).
    match /{document=**} {
      allow read, write: if clan() && request.path[3] != 'zasebno';
    }
    // Naloge vseh map naenkrat (domači zaslon »Moje naloge«).
    match /{pot=**}/naloge/{id} {
      allow read: if clan();
    }
    // Moja mapa: vsak vidi in ureja samo svojo (vsebina, naloge, opombe, gesla ...).
    // Naloge so tu v »moje-naloge«, zato jih skupni pregled nalog (collectionGroup »naloge«) ne zajame.
    match /zasebno/{lastnik}/{pot=**} {
      allow read, write: if clan() && email() == lastnik;
    }
  }
}
