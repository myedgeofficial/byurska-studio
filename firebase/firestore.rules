rules_version = '2';
// Do vsega imajo dostop samo člani ekipe s potrjeno e-pošto:
// Teo, Urška, Nives in Andjela od začetka, ostali, ko jih kdo doda v Nastavitve › Ekipa (dokument clani/{e-pošta}).
service cloud.firestore {
  match /databases/{database}/documents {
    function email() {
      return request.auth.token.email.lower();
    }
    function clan() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (email() in ['teo.simonic7@gmail.com', 'urska.repusic@gmail.com', 'nives.ploj@gmail.com', 'andjela.collab@gmail.com']
            || exists(/databases/$(database)/documents/clani/$(email())));
    }
    // Vse skupno vidijo vsi člani, razen osebnih map (zasebno/{e-pošta}/...) in REMAKO trezorja.
    match /{document=**} {
      allow read, write: if clan() && !(request.path[3] in ['zasebno', 'trezor', 'trezor-stanje']);
    }
    // Naloge vseh map naenkrat (domači zaslon »Moje naloge«).
    match /{pot=**}/naloge/{id} {
      allow read: if clan();
    }
    // Moja mapa: vsak vidi in ureja samo svojo (vsebina, naloge, opombe, gesla ...).
    // Naloge so tu v »moje-naloge«, zato jih skupni pregled nalog (collectionGroup »naloge«) ne zajame.
    match /zasebno/{lastnik}/{pot=**} {
      allow read, write: if clan() && email() == lastnik;
    }
    // REMAKO trezor (spletna stran trezor/): en dokument s šifrirano vsebino.
    // Ime dokumenta (64 hex znakov) nastane iz kode, zato ga pozna samo, kdor ima kodo.
    // Seznam dokumentov ni dovoljen nikomur; podatki so šifrirani v brskalniku.
    // Do REMAKO banke/trezorja sme samo Teo ali Tim, prijavljen z Google računom (2FA na Googlu).
    function bankir() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['teo.simonic7@gmail.com', 'tim.petrovic@gmail.com']
        && request.auth.token.firebase.sign_in_second_factor == 'totp';
    }
    match /trezor/{id} {
      function imeOk() {
        return bankir() && id.matches('^[0-9a-f]{64}$');
      }
      function vsebinaOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['c', 'iv', 'v', 't']) && d.keys().hasAll(['c', 'iv', 'v', 't'])
          && d.c is string && d.c.size() < 900000
          && d.iv is string && d.iv.size() == 16
          && d.v is int && d.t == request.time;
      }
      allow get: if imeOk();
      allow create: if imeOk() && vsebinaOk() && request.resource.data.v == 1;
      allow update: if imeOk() && vsebinaOk() && request.resource.data.v == resource.data.v + 1;
      allow delete: if imeOk();
    }
    // Javna oznaka, da trezor obstaja (stran potem ob napačni kodi ne ponudi novega trezorja).
    match /trezor-stanje/obstaja {
      allow get: if bankir();
      allow create, update: if bankir() && request.resource.data.keys().hasOnly(['obstaja']) && request.resource.data.obstaja == true;
    }
  }
}
