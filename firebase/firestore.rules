rules_version = '2';
// Do vsega imajo dostop samo člani ekipe s potrjeno e-pošto:
// Teo, Urška in Nives od začetka, ostali, ko jih kdo doda v Nastavitve › Ekipa (dokument clani/{e-pošta}).
service cloud.firestore {
  match /databases/{database}/documents {
    function email() {
      return request.auth.token.email.lower();
    }
    function clan() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (email() in ['teo.simonic7@gmail.com', 'urska.repusic@gmail.com', 'nives.ploj@gmail.com']
            || exists(/databases/$(database)/documents/clani/$(email())));
    }
    match /{document=**} {
      allow read, write: if clan();
    }
  }
}
